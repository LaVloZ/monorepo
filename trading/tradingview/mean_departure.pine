//@version=5
// =============================================================================
//  Mean Departure — indicateur de validation visuelle (Pine v5)
//  Version simplifiée : SANS santé du momentum. On marque le départ d'un repli
//  dans une tendance ; c'est l'HUMAIN qui juge le momentum / la qualité à l'œil.
// -----------------------------------------------------------------------------
//    1. Tendance haussière : EMA50 > EMA200 et close > EMA200
//    2. Repli récent        : -2 à -50 % sous le plus-haut ~20 barres,
//                             passage sous l'EMA20 en restant > EMA200
//    3. Volume confirmant   : vol. moyen barres hausse > barres baisse ET > SMA20
//
//  DÉCLENCHEMENT : conditions 1 et 3 vraies + repli qualifiant récent (2)
//                  + close repasse AU-DESSUS de l'EMA20 (le « départ »).
//
//  Affichage : PAS de tracé des EMA (déjà sur ton graphe). Marqueur sur la
//  barre de départ + tableau ✓/✗ des 3 conditions.
//
//  NB : la santé du momentum (3/10 de Raschke) a été retirée volontairement.
//  Version complète avec momentum : commit 57ec5cb.
// =============================================================================

indicator("Mean Departure", overlay = true, max_labels_count = 500)

// ---------------------------------------------------------------------------
//  Inputs
// ---------------------------------------------------------------------------
gT = "Tendance / Repli"
emaFastLen = input.int(20,  "EMA repli (20)",     minval = 1, group = gT)
emaMidLen  = input.int(50,  "EMA tendance (50)",  minval = 1, group = gT)
emaSlowLen = input.int(200, "EMA tendance (200)", minval = 1, group = gT)
hiLookback = input.int(20,  "Fenêtre plus-haut (barres)", minval = 2, group = gT)
minDepth   = input.float(2.0,  "Repli min (%)", minval = 0.0, step = 0.5, group = gT) / 100.0
maxDepth   = input.float(50.0, "Repli max (%)", minval = 0.0, step = 0.5, group = gT) / 100.0
recencyBar = input.int(15, "Repli récent : il y a ≤ N barres", minval = 1, group = gT)

gV = "Volume"
volLen = input.int(20, "Fenêtre volume", minval = 2, group = gV)

gU = "Affichage"
showTable = input.bool(true, "Afficher le tableau", group = gU)
showDebug = input.bool(true, "Afficher le debug (vrais chiffres)", group = gU)
tablePos  = input.string("Haut droite", "Position tableau", options = ["Haut droite", "Haut gauche", "Bas droite", "Bas gauche"], group = gU)

// ---------------------------------------------------------------------------
//  Calculs de base
// ---------------------------------------------------------------------------
emaFast = ta.ema(close, emaFastLen)
emaMid  = ta.ema(close, emaMidLen)
emaSlow = ta.ema(close, emaSlowLen)

// ---------------------------------------------------------------------------
//  Condition 1 — Tendance haussière
// ---------------------------------------------------------------------------
trendUp = emaMid > emaSlow and close > emaSlow

// ---------------------------------------------------------------------------
//  Condition 2 — Repli sain récent
// ---------------------------------------------------------------------------
hh = ta.highest(high, hiLookback)
dd = hh > 0 ? (hh - close) / hh : 0.0
pullbackBar = close < emaFast and close > emaSlow and dd >= minDepth and dd <= maxDepth
bsp = ta.barssince(pullbackBar)
pullbackRecent = not na(bsp) and bsp <= recencyBar

// ---------------------------------------------------------------------------
//  Condition 3 — Volume confirmant
//  vol. moyen barres haussières > barres baissières ET > SMA20 du volume
// ---------------------------------------------------------------------------
isUp   = close > close[1]
upVol   = isUp     ? volume : 0.0
downVol = not isUp ? volume : 0.0
upCnt   = math.sum(isUp     ? 1.0 : 0.0, volLen)
downCnt = math.sum(not isUp ? 1.0 : 0.0, volLen)
avgUpVol   = upCnt   > 0 ? math.sum(upVol,   volLen) / upCnt   : na
avgDownVol = downCnt > 0 ? math.sum(downVol, volLen) / downCnt : na
volSma = ta.sma(volume, volLen)
volConfirm = not na(avgUpVol) and not na(avgDownVol) and avgUpVol > avgDownVol and avgUpVol > volSma

// ---------------------------------------------------------------------------
//  Déclenchement — le « départ »
// ---------------------------------------------------------------------------
departure = ta.crossover(close, emaFast)
trigger   = trendUp and pullbackRecent and volConfirm and departure

// ---------------------------------------------------------------------------
//  Marqueur
// ---------------------------------------------------------------------------
plotshape(trigger, title = "Départ", style = shape.triangleup, location = location.belowbar, color = color.new(color.green, 0), size = size.small, text = "DÉPART")

alertcondition(trigger, title = "Mean Departure — départ", message = "Mean Departure : départ détecté sur {{ticker}} ({{interval}})")

// ---------------------------------------------------------------------------
//  Tableau de diagnostic
// ---------------------------------------------------------------------------
f_pos() =>
    switch tablePos
        "Haut gauche" => position.top_left
        "Bas droite"  => position.bottom_right
        "Bas gauche"  => position.bottom_left
        => position.top_right

f_cell(t, row, label, ok) =>
    table.cell(t, 0, row, label, text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, row, ok ? "✓" : "✗", bgcolor = ok ? color.new(color.green, 20) : color.new(color.red, 20), text_color = color.white, text_size = size.small)

var table diag = table.new(f_pos(), 2, 5, frame_color = color.new(color.gray, 50), frame_width = 1, border_color = color.new(color.gray, 70), border_width = 1)

if showTable and barstate.islast
    table.cell(diag, 0, 0, "Mean Departure", bgcolor = color.new(color.blue, 30), text_color = color.white, text_size = size.small)
    table.cell(diag, 1, 0, "", bgcolor = color.new(color.blue, 30))
    f_cell(diag, 1, "1 Tendance haussière", trendUp)
    f_cell(diag, 2, "2 Repli récent",        pullbackRecent)
    f_cell(diag, 3, "3 Volume confirme",     volConfirm)
    table.cell(diag, 0, 4, "DÉPART (cross EMA" + str.tostring(emaFastLen) + ")", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(diag, 1, 4, trigger ? "✓" : "—", bgcolor = trigger ? color.new(color.green, 0) : color.new(color.gray, 40), text_color = color.white, text_size = size.small)

// ---------------------------------------------------------------------------
//  Debug — vrais chiffres sur la dernière barre
// ---------------------------------------------------------------------------
f_dbg(t, row, label, value) =>
    table.cell(t, 0, row, label, text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, row, value, text_color = color.yellow, text_size = size.small, text_halign = text.align_right)

var table dbg = table.new(position.bottom_right, 2, 5, frame_color = color.new(color.gray, 50), frame_width = 1, border_color = color.new(color.gray, 70), border_width = 1)

if showDebug and barstate.islast
    table.cell(dbg, 0, 0, "DEBUG", bgcolor = color.new(color.orange, 30), text_color = color.white, text_size = size.small)
    table.cell(dbg, 1, 0, "", bgcolor = color.new(color.orange, 30))
    f_dbg(dbg, 1, "Repli actuel (dd)",       str.tostring(dd * 100, "#.#") + " %")
    f_dbg(dbg, 2, "Repli autorisé",          str.tostring(minDepth * 100, "#.#") + "–" + str.tostring(maxDepth * 100, "#.#") + " %")
    f_dbg(dbg, 3, "Dernier repli qualifiant", na(bsp) ? "jamais" : "il y a " + str.tostring(bsp) + " b")
    f_dbg(dbg, 4, "close vs EMA" + str.tostring(emaFastLen), close > emaFast ? "au-dessus" : "en-dessous")
